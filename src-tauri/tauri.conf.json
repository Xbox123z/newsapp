{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Breeze",
  "version": "1.0.0",
  "identifier": "com.breeze.chat",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Breeze · 轻语",
        "width": 420,
        "height": 740,
        "minWidth": 340,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "android": {
      "minSdkVersion": 26
    }
  }
}
